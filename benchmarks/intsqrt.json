{
  "template": "SB ; LOOP { SB } ; SB",
  "inputs":  [{"x": "int"}],
  "outputs": [{"i": "int"}],
  "locals":  [{"v": "int"}],
  "pre":  "x >= 1",
  "post": "(i - 1)*(i - 1) <= x and x < i*i",
  "atoms": {
    "tau@L0": [
      "v == i*i",
      "x >= (i - 1)*(i - 1)",
      "i >= 1",
      "v >= x",
      "i == 1"
    ],
    "g@L0": [
      "v <= x",
      "v < x",
      "i <= x"
    ],
    "phi@L0": [
      "x - (i - 1)*(i - 1)",
      "x - i",
      "x"
    ],
    "s@B0": [
      {"v": "1", "i": "1"},
      {"v": "0", "i": "0"},
      {"v": "x", "i": "1"}
    ],
    "s@B1": [
      {"v": "v + 2*i + 1", "i": "i + 1"},
      {"v": "v + i",       "i": "i + 1"},
      {"v": "v + 2",       "i": "i + 1"}
    ],
    "s@B2": [ {} ]
  },
  "max_solutions": 5
}
